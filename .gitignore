build/
.gradle/
*.apk
*.aab
*.ap_
*.dex
local.properties

# Signing material must never be committed.
keystore.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.DS_Store
captures/

# Desktop build output
desktop/dist/
desktop/node_modules/

# The design handoff is committed extracted, under "Mac app UI mockups (1)/".
# The zip is a byte-for-byte archive of that same directory — 23M of duplicate
# in every clone, and not the copy anyone reads. Ignore the archive, keep the tree.
Mac app UI mockups (1).zip

# Chat transcripts and future drops into the mockups directory.
#
# A chat transcript was swept into a commit by `git add -A` on 2026-08-31 and untracked again.
# This ignores NEW files under that path so the same thing cannot happen twice. It does not
# untrack what is already there: the 33 files of the design handoff — `ConnectSuite.dc.html`,
# `_ds/`, `uploads/` — stay tracked and versioned, because `docs/testing.md`'s measurement passes
# are written against them and a prototype nobody can check out is not a reference.
#
# To add something here deliberately: `git add -f "Mac app UI mockups (1)/<file>"`.
Mac app UI mockups*/

# Packaged artefacts. Built on demand by `npm run dist` in desktop/, never checked in — a .dmg is
# ~100 MB of Electron and it is reproducible from the source beside it.
desktop/release/

# ...but NOT electron-builder's build resources, which are source.
#
# `build/` above is for Gradle's output directories and it swallowed
# `desktop/build/entitlements.mac.plist` — a file described in electron-builder.yml as "present and
# complete" that git did not have. A name collision between Gradle's build *output* and
# electron-builder's build *inputs*, and the sort of thing that is invisible until somebody clones
# the repo and the signed build fails on a missing entitlements file.
!desktop/build/
!desktop/build/**

# graphify's generated knowledge graph. 284 files, ~3.8 MB, rebuilt on demand by the command in
# CLAUDE.md's graphify section. Same category as desktop/release/: derived from the source beside
# it, so checking it in means every code change carries a second, larger, mechanical diff nobody
# reads — and a stale graph in git is worse than no graph, because it reads as current.
graphify-out/

# `npm test`'s own record of its run, read by scripts/check-suites-run.mjs. It is evidence about a
# local run, exactly like Gradle's test-results XML one line up — a committed one would be somebody
# else's reading, served with no indication of whose.
desktop/.test-run.json
desktop/.test-run.tap
