# Copy to keystore.properties and fill in. This file is gitignored - never commit the real one.
#
# Create the keystore first (from the project root):
#
#   keytool -genkeypair -v \
#     -keystore connectsuite-release.jks \
#     -alias connectsuite \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Keep connectsuite-release.jks and these passwords backed up somewhere safe. If you lose them
# you can never publish an update to the same app listing - Play matches updates by signing key.

storeFile=connectsuite-release.jks
storePassword=CHANGE_ME
keyAlias=connectsuite
keyPassword=CHANGE_ME
