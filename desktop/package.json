{
  "name": "connectsuite-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "ConnectSuite for macOS \u2014 pairs with the Android app over TLS on the local network.",
  "main": "entry.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:dir": "npm run build && electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "electron-store": "^8.2.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
