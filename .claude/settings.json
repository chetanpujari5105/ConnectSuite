{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/no-force-stop.sh\"",
            "if": "Bash(adb *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/defects-in-sync.sh\"",
            "if": "Bash(git commit *)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
