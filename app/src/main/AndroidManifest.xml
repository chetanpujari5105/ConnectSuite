<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==== Networking / Wi-Fi Direct discovery (Module 1: Sync) ==== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!--
      Wi-Fi P2P peer discovery requires location up to API 32. Both precisions are declared
      because the system may grant only the coarse one, and no location is ever read or stored.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- API 33+ replaces the location requirement for P2P/scan use cases. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- ==== Foreground services ==== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ==== QR pairing ==== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- ==== Optional, requested at runtime (Phase 4: notifications, SMS, calls, contacts) ==== -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
      Phase 4 additions. Each one is required by a message the `sms` or `calls` capability contract
      makes mandatory, and without it that capability could never be honestly advertised:

        SEND_SMS           sms.send
        CALL_PHONE         call.dial
        ANSWER_PHONE_CALLS call.answer, call.reject

      SEND_SMS in particular was the reason `sms` was permanently grey: Capabilities.kt has always
      required it, and it was declared nowhere in the repo, so no amount of tapping in Settings
      could turn the capability on.

      These are Play "sensitive permission" declarations. See docs/permissions.md for the position
      we are taking on distribution before anyone tries to publish this.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
      ==== Storage, and the photo browser ====

      Two grants on Android 13+ and one below it, which is why CapabilityContract models photos as
      permission *alternatives* rather than a flat any-of: READ_MEDIA_IMAGES alone satisfies a flat
      any-of and leaves every video in `media.list` unreadable behind a green capability chip.

      READ_EXTERNAL_STORAGE keeps its maxSdkVersion="32". The cap is not what was stopping photos —
      the undeclared READ_MEDIA_* permissions were — and removing it would make
      CapabilityPermissionTest.grantableToday() report this permission as grantable on Android 16,
      where the system ignores it entirely. That would put the false reading inside the check that
      exists to catch false readings.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!--
      Defect 139. Declared so Android 14+ treats "Allow limited access" as a real, lasting grant of
      the photos the person picked. Undeclared, Android ran the app in compatibility mode: a limited
      pick handed out READ_MEDIA_IMAGES/VIDEO as a one-time grant (REVOKED_COMPAT|ONE_TIME) that the
      checklist read as full access and lost on the next process start. Requested with the two above
      — see MediaAccess.requestFor — and asking again is Android's own change-selection flow.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />
    <!--
      SMS mirroring is an optional extra, so a tablet or Wi-Fi-only device with no telephony
      radio must still be able to install the app.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".ConnectSuiteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConnectSuite"
        tools:targetApi="34">

        <!--
          singleTop so the "start mirroring" notification reaches onNewIntent when the app is
          already running. Without it the launcher Intent only brings the task forward and the
          tab-to-open extra is dropped, which lands the user on whatever tab they left.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.ConnectSuite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          **Send selected text to the Mac** — the only cheap trigger Android permits, measured in
          `docs/testing.md` → Phase 7 Slice 17. `ACTION_PROCESS_TEXT` puts this in the text-selection
          toolbar beside Copy; `ACTION_SEND` puts it in the share sheet. **Neither reads the
          clipboard** — the text arrives in the Intent — which is why they are not subject to the
          background-read rule that makes the phone→Mac direction need the app on screen.

          Translucent and `noHistory`: it has no UI, finishes in `onCreate`, and must never be
          something the back gesture returns to. `excludeFromRecents` for the same reason — a
          recents card for an activity that lives 40ms is litter.

          The label is what the user reads in the toolbar, where there is room for two or three
          words and the app's own name is already the icon's job.

          An empty `taskAffinity`, as its share neighbours have (2026-10-08): without it a caller's
          `FLAG_ACTIVITY_NEW_TASK` launch lands in Sidekick's own task and brings `MainActivity`
          forward, and its focus starts a clipboard sync nobody asked for. `ShareManifestTest` holds it.
        -->
        <activity
            android:name=".SendSelectionActivity"
            android:exported="true"
            android:label="@string/send_selection_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              `text/*`, not only `text/plain`: a text **file** shared from My Files (`.txt`, `.csv`,
              `.json`, `.md`, `.vcf`…) arrives as SEND with its own text type and an EXTRA_STREAM. The
              activity forwards anything carrying a stream to ShareToMacActivity (ShareTextRoute), so
              a file is sent as a file and a selection of text still goes to clip.push.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!--
          Feature A, slice 1 (`docs/phase-7-share-plan.md`): one file from any app's share sheet,
          copied privately while this activity holds the grant. It sends nothing in this slice.

          The filter claims no `text/*` and no `*/*`, so a plain-text share never lists it and keeps
          going to SendSelectionActivity → clip.push. The recorded trade-off: a text *file*
          (`text/plain` with a stream) does not list it either in v1. No SEND_MULTIPLE: one file only.
          `ShareManifestTest` holds all three.

          `excludeFromRecents` and an empty `taskAffinity`: it belongs to the sharing app's moment,
          not to Sidekick's task. Leaving it discards the prepared copy (see the class comment).
        -->
        <activity
            android:name=".ShareToMacActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/share_to_mac_label"
            android:theme="@style/Theme.ConnectSuite">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="font/*" />
                <data android:mimeType="model/*" />
            </intent-filter>
        </activity>

        <!--
          Several files from one Gallery or My Files multi-select (docs/protocol.md → Share → Version 3;
          docs/feature-a-multi-offer-proposal.md rev 4 §3, §11-§15). Same types as the single-file filter
          above, no text, SEND_MULTIPLE only; one file selected is handled as the single-file sheet.
          Enabled by @bool/share_many_enabled: true in debuggable builds, and in release only once the
          owner flips Extensions.MULTI_FILE_RELEASE (the two are held equal by ShareManyManifestTest).
        -->
        <activity
            android:name=".ShareManyToMacActivity"
            android:enabled="@bool/share_many_enabled"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/share_to_mac_label"
            android:theme="@style/Theme.ConnectSuite">
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!--
                  `text/*` too (2026-09-29): a My Files selection of .txt/.csv/.json files is sent as
                  text/plain or text/*, and without this Sidekick was not in the share sheet at all.
                  Plain text is never a SEND_MULTIPLE, so this takes nothing from clip.push.
                -->
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="font/*" />
                <data android:mimeType="model/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
