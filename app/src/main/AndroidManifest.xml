<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==== Networking / Wi-Fi Direct discovery (Module 1: Sync) ==== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!--
      Wi-Fi P2P peer discovery requires location up to API 32. Both precisions are declared
      because the system may grant only the coarse one, and no location is ever read or stored.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- API 33+ replaces the location requirement for P2P/scan use cases. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- ==== Foreground services ==== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ==== QR pairing ==== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- ==== Optional, requested at runtime (Phase 4: notifications, SMS, calls, contacts) ==== -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
      Phase 4 additions. Each one is required by a message the `sms` or `calls` capability contract
      makes mandatory, and without it that capability could never be honestly advertised:

        SEND_SMS           sms.send
        CALL_PHONE         call.dial
        ANSWER_PHONE_CALLS call.answer, call.reject

      SEND_SMS in particular was the reason `sms` was permanently grey: Capabilities.kt has always
      required it, and it was declared nowhere in the repo, so no amount of tapping in Settings
      could turn the capability on.

      These are Play "sensitive permission" declarations. See docs/permissions.md for the position
      we are taking on distribution before anyone tries to publish this.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
      ==== Storage, and the photo browser ====

      Two grants on Android 13+ and one below it, which is why CapabilityContract models photos as
      permission *alternatives* rather than a flat any-of: READ_MEDIA_IMAGES alone satisfies a flat
      any-of and leaves every video in `media.list` unreadable behind a green capability chip.

      READ_EXTERNAL_STORAGE keeps its maxSdkVersion="32". The cap is not what was stopping photos —
      the undeclared READ_MEDIA_* permissions were — and removing it would make
      CapabilityPermissionTest.grantableToday() report this permission as grantable on Android 16,
      where the system ignores it entirely. That would put the false reading inside the check that
      exists to catch false readings.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />
    <!--
      SMS mirroring is an optional extra, so a tablet or Wi-Fi-only device with no telephony
      radio must still be able to install the app.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".ConnectSuiteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConnectSuite"
        tools:targetApi="34">

        <!--
          singleTop so the "start mirroring" notification reaches onNewIntent when the app is
          already running. Without it the launcher Intent only brings the task forward and the
          tab-to-open extra is dropped, which lands the user on whatever tab they left.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.ConnectSuite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
