<resources>
    <string name="app_name">Sidekick</string>
    <!--
      The text-selection toolbar label. Two or three words is the whole budget there — the toolbar
      truncates and the app's own name is the icon's job. "Send to Mac" says the destination, which
      is the only thing a person choosing between Copy, Share and Translate needs.
    -->
    <string name="send_selection_label">Send to Mac</string>
    <!--
      The file share-sheet label (ShareToMacActivity). The same words as the selection label, and the
      two never appear in one list: this one claims no text/*, that one claims only text/plain.
    -->
    <string name="share_to_mac_label">Send to Mac</string>
    <string name="tab_sync">Sync</string>
    <string name="tab_mirror">Mirror</string>
</resources>
