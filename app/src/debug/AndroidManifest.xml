<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          THE GATE (defect 152). Every exported activity here that has no intent filter is an
          adb-driven harness, and each requires android.permission.DUMP. "Debug-only" keeps these out
          of a release build; it does not keep them away from other apps on a phone that has a debug
          build installed, and one of them (ShareOfferProbeActivity) makes the phone offer data to the
          paired Mac. DUMP is held by the shell user that `adb shell am start` runs as, and its
          protection level is signature|privileged|development, so an ordinary installed app cannot hold
          it. DebugProbeGateTest fails if a filter-less exported activity here lacks it. The two
          share-sheet probes below carry a SEND filter and must stay reachable from the share sheet, so
          they are not gated.
        -->
        <!--
          Debug source set only. It is never merged into a release manifest, so this activity does
          not exist in a shipping build — the same containment as `ClipProbeActivity`.

          `exported="true"`, and that is a deliberate, stated trade rather than an oversight. The
          harness is driven by `adb shell am start`, which runs as uid 2000 and is refused by a
          non-exported component:

              SecurityException: … not exported from uid 10237

          So an unexported harness is one that cannot be started by the only thing that starts it.
          What is exposed is bounded: the activity reads no user data, touches no ViewModel, opens
          no socket and renders a hardcoded sample state. There is no launcher intent filter, so it
          has no icon and cannot be reached by tapping.
        -->
        <activity
            android:name="com.chetan.connectsuite.designpreview.DesignPreviewActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ConnectSuite" />

        <!--
          Same containment and the same reason for `exported="true"`: it is started by
          `adb shell am start` and nothing else. It draws no UI, finishes immediately, reads no
          user data, and writes only to logcat. See the class comment for why it has to exist at
          all — the address it prints has no other surface on a phone that is already paired.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.PhoneAddressProbe"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Defect 137. Same containment and the same reason for `exported="true"`. No UI, finishes
          immediately, requests no grant and writes nothing; one children query per granted tree
          root, capped at 20 rows, and logcat carries counts, column names and failure categories
          only — never a file name.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.SafChildrenProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!--
          `docs/phase-7-share-proposal.md` §4, the URI-grant lifetime experiment. Debug source set
          only, like every probe here. It must be a Sharesheet target to receive a real grant, so it
          is exported with a SEND filter, and that filter is narrowed to the two synthetic stimuli's
          types (`image/png`, `application/octet-stream`): no `text/*`, so a plain-text share never
          lists it and `SendSelectionActivity` keeps that path, and no `SEND_MULTIPLE`. The label
          says "debug" so nobody mistakes it for Feature A. It reads the stream, logs counts and a
          digest, and finishes; it shows nothing and writes nothing.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareGrantProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="Sidekick grant probe (debug)"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!--
          2026-09-28: turns ShareManyToMacActivity or ShareManyGrantProbeActivity on, or back to its
          manifest default. The shell's `pm enable` was refused on the SDK 37 emulator; an app may
          always change its own components. adb-driven harness: exported, no filter, DUMP-gated.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareManyComponentsActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!--
          docs/feature-a-multi-offer-proposal.md rev 4 §11, the SEND_MULTIPLE URI-grant measurement
          (2026-09-28, development only). Debug source set only, and **disabled**: it is in no share
          sheet until someone runs `pm enable` on this component, in a supervised run. The filter is
          narrowed to the synthetic stimuli's types (`image/png`, `application/octet-stream`,
          `application/pdf`) — no `text/*`, no wildcard. Not excluded from recents: its stopped phase
          needs the owner to be able to come back to it. It reads, digests and drops; it writes nothing.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareManyGrantProbeActivity"
            android:enabled="false"
            android:exported="true"
            android:taskAffinity=""
            android:label="Sidekick multi grant probe (debug)"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <!--
          `docs/phase-7-share-proposal.md` rev 2 §5, the private-staging proof. Debug source set only,
          not Feature A: it copies one shared file into `cacheDir/share-staging/` while it owns the
          grant, shows counts and digests, and sends nothing anywhere. Same SEND filter as the grant
          probe, for the same two synthetic stimuli — no `text/*`, no `SEND_MULTIPLE`.

          No `configChanges`: a rotation must recreate it, because recreation is one of the things
          it exists to test.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareStagingProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="Sidekick staging proof (debug)"
            android:theme="@style/Theme.ConnectSuite">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Feature A slice 2: the only thing that makes a share offer. Debug source set only, started
          by `adb shell am start` (hence exported, like the other probes here), no intent filter, no
          launcher entry, no UI. It stages generated synthetic bytes and offers them; it reads no
          user data. Ordinary shares never reach the offer path in this slice.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareOfferProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Feature A slice 3e (docs/phase-7-share-3e-runbook.md §1): the ONLY writer of ShareDevGate —
          arms share.file 2 for the phone's next trusted handshake, in memory, in a debuggable build.
          Debug source set only; DUMP-gated like the offer probe; no filter, no launcher, no UI.
          ShareDevGateRoutingTest pins this entry and its absence from the main manifest.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareDevV2Activity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Feature A version 3, Stage 1 (docs/feature-a-multi-offer-proposal.md §18): the ONLY writer of
          ShareDevGate.v3 — arms share.file 3 for the phone's next trusted handshake, in memory, in a
          debuggable build. Debug source set only; DUMP-gated; no filter, no launcher, no UI.
          ShareDevGateRoutingTest pins this entry and its absence from the main manifest.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.ShareDevV3Activity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          The cache quota for the concurrent-staging rule (docs/feature-a-multi-offer-proposal.md §4):
          no system view on the SM-S938B exposes it, so it is read by code running as this app. Debug
          source set only; DUMP-gated like every adb harness here; no filter, no launcher, no UI. Reads
          once, writes nothing, creates nothing; logcat carries byte counts, a timestamp and exception
          classes only. StorageQuotaProbeManifestTest pins this entry and its absence from main.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.StorageQuotaProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          L1/L2 T4-A (2026-10-01): the ONLY writer of FsCorruptionProbe.arm. It no longer arms a global
          corruption of "the next pull of any kind" (why it was left undeclared after slice 3c); it arms
          one fixed byte of one block pull of one document in downloads:connectsuite, bound to the one
          live session, one-shot, expiring. Debug source set only; DUMP-gated; no filter, no launcher, no
          UI. FsProbeManifestTest pins this entry and its absence from main.
        -->
        <activity
            android:name="com.chetan.connectsuite.probe.FsProbeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
