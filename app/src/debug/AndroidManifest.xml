<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. This source set is not merged into a release build, so SafProbeActivity cannot ship.
  It is exported so `adb shell am start -n` can launch it; that is the whole reason it exists, and
  it is why it must not exist outside a debug build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.chetan.connectsuite.probe.SafProbeActivity"
            android:exported="true"
            android:label="SAF probe"
            android:theme="@style/Theme.ConnectSuite" />
    </application>
</manifest>
